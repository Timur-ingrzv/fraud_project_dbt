[sqlfluff]
exclude_rules = CP01, CP03, ST06
dialect = clickhouse
templater = dbt
processes = 1
max_line_length = 100

[sqlfluff:templater:dbt]
project_dir = .
profiles_dir = .

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper